# Port HTTP du serveur
PORT=4000
# Compte admin créé au premier démarrage (changez le mot de passe ensuite dans Admin › Mon compte)
ADMIN_EMAIL=admin@duravelbuilding.com
ADMIN_PASSWORD=ChangeMoi!2026
# Secret de session (laisser vide = généré automatiquement dans data/.jwt_secret)
JWT_SECRET=
# Optionnel : notification e-mail à chaque demande de devis
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO=
# Optionnel : emplacements des données (utile en hébergement avec volume persistant)
# DATA_DIR=/var/data/duravel
# UPLOAD_DIR=/var/data/duravel/uploads
