# Port HTTP (laisser vide sur Hostinger, Hostinger l'injecte automatiquement)
PORT=4000

# Compte administrateur créé au premier démarrage (à personnaliser)
ADMIN_EMAIL=admin@duravelbuilding.com
ADMIN_PASSWORD=ChangeMoi!2026

# Secret JWT pour les sessions (laisser vide = généré automatiquement dans data/.jwt_secret)
JWT_SECRET=

# Optionnel : notifications e-mail pour les demandes de devis
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO=
